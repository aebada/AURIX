# Copy to auth-lib/.env on the server (NEVER commit real secrets).
# Protected by auth-lib/.htaccess (Require all denied).

APP_URL=https://aurixapp.de
APP_ENV=production

# MySQL (your host's control panel — Databases / phpMyAdmin)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your-database-password

# Google OAuth — server-side authorization-code flow, so (unlike the
# client-side Google Identity Services flow used elsewhere in this repo)
# the client secret IS required here. It stays server-side, in this .env
# file only, never sent to the browser.
#
# Public Client ID used by the live FTP build (also in
# .github/workflows/deploy-website.yml as NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# Safe to commit; the secret must NOT be.
GOOGLE_CLIENT_ID=148156861979-ua974fq9iatjv2gvfneh9cga49efb0mm.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Direct OAuth only (AIPASS_OAUTH_BRIDGE=false / APP_ENV=local). Production
# uses the AI-Pass bridge below — Google’s redirect_uri stays
# https://aipass.space/auth/google/callback (already registered).
# Local/direct path matches HOPn apps: /auth/google/callback
GOOGLE_REDIRECT_URI=https://aurixapp.de/auth/google/callback

# AI-Pass OAuth bridge (production default — same concept as Invoice AI).
# Consent runs on aipass.space; AURIX receives a signed bridge_token.
# Requires aurixapp.de in AI-Pass AIPASS_TRUSTED_CALLBACK_HOSTS.
AIPASS_AUTH_URL=https://aipass.space
AIPASS_OAUTH_BRIDGE=true
# Defaults to GOOGLE_CLIENT_SECRET when unset (must match AI-Pass
# GOOGLE_CLIENT_SECRET / AIPASS_OAUTH_BRIDGE_SECRET).
# AIPASS_OAUTH_BRIDGE_SECRET=

# Session hardening (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Post-login redirect. Point this at a real destination once one exists
# (e.g. an account page on this site, or apps/web once it has a live
# host) — defaults to the homepage otherwise.
LOGIN_SUCCESS_URL=/

# Optional AI keys for /auth/chat.php (marketing "Ask AURIX" widget).
# Same provider cascade as services/backend — first configured key wins.
# Leave unset to serve demo FAQ replies. Never put these in the Next.js
# client env / static export.
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# SAMBANOVA_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Public contact address (mailto / auto-reply footer). Not a secret.
PUBLIC_CONTACT_EMAIL=contact@aurixapp.de

# Hostinger Mail (contact@aurixapp.de) — SMTP for inquiry notify / auto-reply.
# Used by /auth/investor-inquiry.php after persisting the JSON intake.
# Never commit real SMTP_PASS — put it only in auth-lib/.env on the server.
# Do NOT reuse the mailbox password as FTP/SSH deploy credentials.
#
# SMTP (php-auth sends here):
#   Host smtp.hostinger.com | Port 465 SSL (or 587 STARTTLS)
# IMAP (Outlook / mail clients only — not used by php-auth):
#   Host imap.hostinger.com | Port 993 SSL
# Username = full email contact@aurixapp.de
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=contact@aurixapp.de
SMTP_PASS=
SMTP_FROM=contact@aurixapp.de
SMTP_FROM_NAME=AURIX
# Where new inquiries are delivered (defaults to SMTP_FROM).
MAIL_NOTIFY_TO=contact@aurixapp.de
MAIL_AUTO_REPLY=true

# MunichTech EXPO / AIPass CRM lead upsert (production).
# Same keyed route as Team-Management / MTE scripts:
#   GET {MTE_CRM_BASE}/upsert-outreach-lead?key=…
# Contact, investor, partner, and business forms hit this via investor-inquiry.php.
# Tags email_source=aurix_{kind} and tags=AURIX,aurix_{kind}. Never commit real keys.
# Default base is munichtechexpo.com admin (historical crm.aipass.space CRM).
# Alias: MIGRATE_DEPLOY_KEY= (used when MTE_CRM_KEY is empty).
MTE_CRM_ENABLED=true
MTE_CRM_BASE=https://munichtechexpo.com/back/admin
MTE_CRM_KEY=
# MIGRATE_DEPLOY_KEY=
