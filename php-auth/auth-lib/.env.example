# Copy to auth-lib/.env on the server (NEVER commit real secrets).
# Protected by auth-lib/.htaccess (Require all denied).

APP_URL=https://aurixapp.de
APP_ENV=production

# MySQL (your host's control panel — Databases / phpMyAdmin)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your-database-password

# Google OAuth — server-side authorization-code flow, so (unlike the
# client-side Google Identity Services flow used elsewhere in this repo)
# the client secret IS required here. It stays server-side, in this .env
# file only, never sent to the browser.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://aurixapp.de/auth/google-callback.php

# Session hardening (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# Post-login redirect. Point this at a real destination once one exists
# (e.g. an account page on this site, or apps/web once it has a live
# host) — defaults to the homepage otherwise.
LOGIN_SUCCESS_URL=/
