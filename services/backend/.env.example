PORT=4000

# Replace with a real secret from a secrets manager before any real
# deployment — this is a local-dev-only placeholder.
JWT_SECRET=replace-me-with-a-real-secret

# OAuth 2.0 Client ID from Google Cloud Console (safe to expose to the
# frontend — it's the expected "audience" for verifying Google ID tokens,
# not a secret). Leave unset to disable /auth/google (returns 503).
GOOGLE_CLIENT_ID=

# AI chatbot (/chat/message) — each of these is optional. The router tries
# them in order (roughly most-generous-free-tier first), skipping any that
# are unset, and skips one for the rest of the day the moment it reports a
# quota/rate-limit error. Leave all unset to disable /chat/message (503).
CEREBRAS_API_KEY=
GROQ_API_KEY=
SAMBANOVA_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
