PORT=4000

# Replace with a real secret from a secrets manager before any real
# deployment — this is a local-dev-only placeholder.
JWT_SECRET=replace-me-with-a-real-secret

# OAuth 2.0 Client ID from Google Cloud Console (safe to expose to the
# frontend — it's the expected "audience" for verifying Google ID tokens,
# not a secret). Leave unset to disable /auth/google (returns 503).
GOOGLE_CLIENT_ID=
