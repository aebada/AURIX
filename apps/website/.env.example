NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth 2.0 Client ID from Google Cloud Console (baked in at build time —
# safe to expose, it's not a secret). Leave unset to hide the Google
# sign-in button entirely rather than show a broken one.
# Production FTP build uses:
#   148156861979-ua974fq9iatjv2gvfneh9cga49efb0mm.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# When "1", /login and nav CTAs hand off to php-auth's server-rendered
# pages (see docs/PHP-AUTH.md) instead of calling NEXT_PUBLIC_API_URL —
# use this for the live FTP build, since there's no hosted
# services/backend for the static site to actually reach. Leave unset for
# local development against a running services/backend.
# Production FTP build sets this to "1" in .github/workflows/deploy-website.yml.
NEXT_PUBLIC_USE_PHP_AUTH=

# Public chat endpoint for the floating "Ask AURIX" widget (POST JSON:
# { message, history? } → { reply, provider }). No API secrets belong here —
# only the URL. When NEXT_PUBLIC_USE_PHP_AUTH=1 and this is unset, the
# widget defaults to /auth/chat.php (php-auth proxy; keys live in
# auth-lib/.env on the server). Leave empty locally to use demo FAQ replies.
NEXT_PUBLIC_CHAT_API_URL=
